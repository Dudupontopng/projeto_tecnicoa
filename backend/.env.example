PORT=3000

# Conexao com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ponte_alimentar

# Chave secreta do JWT (OBRIGATORIA). Gere uma com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Origem do front-end liberada no CORS
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Administrador inicial criado por "npm run seed"
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=
